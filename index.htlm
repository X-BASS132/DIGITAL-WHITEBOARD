                    img.onload = () => {
                        const targetX = (canvas.width - containerWidth) / 2;
                        const targetY = (canvas.height - containerHeight) / 2;
                        
                        const tempC = document.createElement('canvas');
                        tempC.width = containerWidth;
                        tempC.height = containerHeight;
                        const tempCtx = tempC.getContext('2d');
                        tempCtx.drawImage(img, 0, 0);
                        const imgData = tempCtx.getImageData(0, 0, containerWidth, containerHeight);

                        URL.revokeObjectURL(url);
                        document.body.removeChild(container);
                        
                        activateObjectSelection(targetX, targetY, containerWidth, containerHeight, imgData);
                    };

                    img.onerror = () => {
                        ctx.save();
                        ctx.font = 'bold 36px "Caveat", cursive, sans-serif';
                        ctx.fillStyle = penColor;
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'middle';
                        const fallbackText = textToStamp
                            .replace(/\\frac{([^}]+)}{([^}]+)}/g, '($1/$2)')
                            .replace(/\\sqrt{([^}]+)}/g, '√($1)')
                            .replace(/\\pm/g, '±')
                            .replace(/[\\]/g, '');
                        ctx.fillText(fallbackText, canvas.width / 2, canvas.height / 2);
                        ctx.restore();
                        document.body.removeChild(container);
                    };

                    img.src = url;

                } catch (err) {
                    console.error("LaTeX Stamp Error:", err);
                    if (document.body.contains(container)) {
                        document.body.removeChild(container);
                    }
                }

                setIsMathModalOpen(false);
            };

                            Math.pow(currentY - startPosRef.current.y, 2)
                        );
                        ctx.beginPath();
                        ctx.arc(startPosRef.current.x, startPosRef.current.y, radius, 0, 2 * Math.PI);
                        ctx.stroke();
                    } else if (tool === 'rect') {
                        const w = currentX - startPosRef.current.x;
                        const h = currentY - startPosRef.current.y;
                        ctx.strokeRect(startPosRef.current.x, startPosRef.current.y, w, h);
                    } else {
                        const dx = currentX - startPosRef.current.x;
                        const dy = currentY - startPosRef.current.y;
                        const angle = Math.atan2(dy, dx);
                        const snappedAngle = Math.round(angle / (Math.PI / 4)) * (Math.PI / 4);
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        const snapX = startPosRef.current.x + Math.cos(snappedAngle) * dist;
                        const snapY = startPosRef.current.y + Math.sin(snappedAngle) * dist;

                        drawSmoothStroke([startPosRef.current, { x: snapX, y: snapY }], ctx, true);
                    }
                    return;
                }
<!-- ... existing code ... -->
            const handlePointerUp = (e) => {
                const canvas = canvasRef.current;
                if (canvas && isDrawingRef.current && (tool === 'circle' || tool === 'rect')) {
                    const rect = canvas.getBoundingClientRect();
                    const currentX = e.clientX - rect.left;
                    const currentY = e.clientY - rect.top;
                    const ctx = canvas.getContext('2d');

                    let x, y, width, height;
                    if (tool === 'rect') {
                        x = Math.min(startPosRef.current.x, currentX);
                        y = Math.min(startPosRef.current.y, currentY);
                        width = Math.abs(currentX - startPosRef.current.x);
                        height = Math.abs(currentY - startPosRef.current.y);
                    } else if (tool === 'circle') {
                        const radius = Math.sqrt(
                            Math.pow(currentX - startPosRef.current.x, 2) + 
                            Math.pow(currentY - startPosRef.current.y, 2)
                        );
                        x = startPosRef.current.x - radius;
                        y = startPosRef.current.y - radius;
                        width = radius * 2;
                        height = radius * 2;
                    }

                    if (width > 5 && height > 5) {
                        ctx.putImageData(snapshotRef.current, 0, 0);
                        
                        const shapeCanvas = document.createElement('canvas');
                        shapeCanvas.width = width;
                        shapeCanvas.height = height;
                        const sCtx = shapeCanvas.getContext('2d');
                        sCtx.lineWidth = penWidth;
                        sCtx.strokeStyle = penColor;

                        if (tool === 'rect') {
                            sCtx.strokeRect(0, 0, width, height);
                        } else if (tool === 'circle') {
                            const r = width / 2;
                            sCtx.beginPath();
                            sCtx.arc(r, r, r - penWidth, 0, 2 * Math.PI);
                            sCtx.stroke();
                        }

                        const shapeData = sCtx.getImageData(0, 0, width, height);
                        activateObjectSelection(x, y, width, height, shapeData);
                    }
                }

                if (tool === 'select') {
                    if (isDraggingSelectionRef.current) {
                        isDraggingSelectionRef.current = false;
                        return;
                    }
                    if (isDrawingRef.current) {
                        if (canvas) {
                            const rect = canvas.getBoundingClientRect();
                            const currentX = e.clientX - rect.left;
                            const currentY = e.clientY - rect.top;
                            const x = Math.min(startPosRef.current.x, currentX);
                            const y = Math.min(startPosRef.current.y, currentY);
                            const width = Math.abs(currentX - startPosRef.current.x);
                            const height = Math.abs(currentY - startPosRef.current.y);

                            if (width > 10 && height > 10) {
                                const ctx = canvas.getContext('2d');
                                ctx.putImageData(snapshotRef.current, 0, 0);
                                const regionData = ctx.getImageData(x, y, width, height);

                                ctx.clearRect(x, y, width, height);

                                setSelectedRegion({
                                    x, y, width, height, imgData: regionData
                                });
                                AudioFX.play('click');
                            } else {
                                const ctx = canvas.getContext('2d');
                                ctx.putImageData(snapshotRef.current, 0, 0);
                            }
                        }
                    }
                }

                if (activePointerIdRef.current === e.pointerId) {
                    if (canvas && canvas.hasPointerCapture(e.pointerId)) {
                        canvas.releasePointerCapture(e.pointerId);
                    }
                    activePointerIdRef.current = null;
                    isDrawingRef.current = false;
                    pointsRef.current = [];
                }
            };
